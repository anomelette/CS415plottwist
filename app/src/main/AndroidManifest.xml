<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Keep the <application> attributes Android Studio generated (icon, theme, etc.).
         The theme name below matches a project named "ScrollReader". -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScrollReader"
        tools:targetApi="31">

        <activity
            android:name="com.example.scrollreader.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reading break: own task so it sits on top of TikTok etc. and stays out of Recents. -->
        <activity
            android:name="com.example.scrollreader.ReadingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="" />

        <service
            android:name="com.example.scrollreader.ScrollWatcherService"
            android:exported="false"
            android:label="Scroll Reader"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/scroll_watcher_config" />
        </service>
    </application>
</manifest>
